{
  "name": "my-kravv",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/v3/local.ts dev",
    "build": "node scripts/v3/local.ts build",
    "start": "node scripts/v3/local.ts serve",
    "v3:doctor": "node scripts/v3/local.ts doctor",
    "v3:up": "node scripts/v3/local.ts start",
    "v3:reset": "node scripts/v3/local.ts reset",
    "v3:test": "node scripts/v3/local.ts test",
    "v3:cloud:dev": "node scripts/v3/cloud.ts dev",
    "v3:cloud:build": "node scripts/v3/cloud.ts build",
    "v3:cloud:serve": "node scripts/v3/cloud.ts serve",
    "v3:cloud:test": "node scripts/v3/cloud.ts test",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --conditions=react-server --test src/tests/*.test.ts",
    "test:live": "node --env-file=.env.local --conditions=react-server --test src/tests/live/*.test.ts",
    "test:ai-smoke": "node --env-file=.env.local --conditions=react-server scripts/ai-smoke.ts",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm test",
    "v3:ui:preview": "node scripts/v3/ui-preview.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "next": "16.4.0",
    "openai": "7.30.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "overrides": {
    "supabase": {
      "tar": "7.5.22"
    }
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.9",
    "supabase": "2.75.0",
    "typescript": "5.9.3"
  }
}
