# V3 Slice 0 uses guarded npm commands; no manually copied secrets are needed.
# See supabase/v3/README.md. Existing V2 .env.local is preserved, never a fallback.
# The launcher supplies the exact local URL/profile and CLI publishable key in memory.
# Only the isolated integration-test child receives the local privileged key.
# Do not add remote Supabase or AI-provider credentials for Slice 0.
NEXT_PUBLIC_MY_KRAVV_ENV=my-kravv-v3-local-01a14897
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
