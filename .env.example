NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=

# AI configuration is lazy; normal login, Company and Thought operations need none.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Explicit model capabilities/prices; see src/server/ai/README.md for JSON example.
AI_MODEL_CONFIG_JSON=
# Supply a deliberate current planning rate; no exchange-rate lookup or default.
AI_USD_TO_IDR=
AI_MONTHLY_COST_LIMIT_IDR=25000
AI_DAILY_CALL_LIMIT=20
AI_TIMEOUT_MS=15000
# Optional per-role override; each selected model needs its own priced config entry.
AI_ROLE_REFINE_MODEL=
AI_ROLE_STRUCTURE_MODEL=
AI_ROLE_GUIDE_MODEL=
AI_ROLE_CHALLENGE_MODEL=
AI_ROLE_COMPARE_MODEL=
AI_ROLE_REFLECT_MODEL=
